<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView's storage holds the unlock key and cached decrypted modules,
     so nothing leaves the device via cloud backup or phone-to-phone transfer.
     Cost: on a new phone the buyer re-enters their key once. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
