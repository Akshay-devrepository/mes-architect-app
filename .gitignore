# NEVER commit this — it's the plaintext license keys for every paid module
# and the bundle master key. If this ends up in a commit, every module is
# permanently free for anyone who reads git history, even after deleting it.
LICENSE-KEYS-SECRET.md

# Resume cache for scripts/generate-translations.js — just translated
# chunk text keyed by position, nothing sensitive, but it's a working
# cache, not a source artifact.
.translation-checkpoint.json

node_modules/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/app/release/

# Release signing. Lose the keystore and you can never publish an update to
# this app on any store again — back it up somewhere outside this repo.
# Commit it and anyone who reads the repo can ship an update as you.
# android/app/debug.keystore is the deliberate exception: it's the universal
# Android debug key, committed so every CI build can update the last one.
android/keystore.properties
*.jks
*.keystore
!android/app/debug.keystore

*.apk
*.aab
.DS_Store
Thumbs.db
